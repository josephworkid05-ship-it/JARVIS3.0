# ==============================================================================
# J.A.R.V.I.S. Personal AI Assistant - Environment Configuration
# ==============================================================================

# User & Assistant Customization
JARVIS_NAME="J.A.R.V.I.S."
USER_NAME="Sir"

# LLM Provider Selection: "openai", "gemini", or leave blank for auto-detection
LLM_PROVIDER=""

# ------------------------------------------------------------------------------
# Option 1: OpenAI or OpenAI-Compatible (Groq, DeepSeek, Ollama, LM Studio)
# ------------------------------------------------------------------------------
# For OpenAI:
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# For Groq (Ultra-fast):
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# OPENAI_MODEL="llama-3.1-70b-versatile"
# OPENAI_API_KEY="gsk_..."

# For Local Ollama:
# OPENAI_BASE_URL="http://localhost:11434/v1"
# OPENAI_MODEL="llama3"
# OPENAI_API_KEY="ollama"

# ------------------------------------------------------------------------------
# Option 2: Google Gemini
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ------------------------------------------------------------------------------
# Reasoning & Memory Limits
# ------------------------------------------------------------------------------
TEMPERATURE=0.3
MAX_TOKENS=1024
MAX_AGENT_STEPS=5
MEMORY_WINDOW_SIZE=15
LOG_LEVEL="INFO"
